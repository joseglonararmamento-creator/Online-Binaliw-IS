rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : {};
    }

    function isTeacher() {
      return isSignedIn() && getUserData().get('role', '') == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getUserData().get('role', '') == 'student';
    }

    // --- Collections ---

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isOwner(existing().authorId) || incoming().diff(existing()).affectedKeys().hasOnly(['likes']));
      allow delete: if isSignedIn() && (isOwner(existing().authorId) || isTeacher());
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && isOwner(existing().teacherId);
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && isOwner(existing().teacherId);
    }

    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create: if isStudent();
      allow update: if isTeacher();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isOwner(existing().userId);
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isOwner(existing().userId);
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && isOwner(existing().teacherId);

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    match /friends/{friendshipId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && isOwner(existing().teacherId);
    }

    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isStudent();
    }
    
    match /reminders/{reminderId} {
      allow read: if isSignedIn();
      allow create: if isTeacher();
      allow update, delete: if isTeacher() && isOwner(existing().teacherId);
    }

    match /chats/{chatId} {
      allow read, create, update: if isSignedIn() && chatId.contains(request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn() && chatId.contains(request.auth.uid);
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
        allow delete: if isSignedIn() && existing().senderId == request.auth.uid;
        allow update: if isSignedIn();
      }

      match /typing/{userId} {
        allow read, write: if isSignedIn();
      }
    }

    match /confessions/{confessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isOwner(existing().authorId) || isTeacher());
    }

    match /comments/{commentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow delete: if isSignedIn() && (isOwner(existing().authorId) || isTeacher());
    }

    match /calendarEvents/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isTeacher();
    }

    match /post_likes/{likeId} {
      allow read, create, delete: if isSignedIn();
    }

    match /confession_likes/{likeId} {
      allow read, create, delete: if isSignedIn();
    }

    // Connectivity Test
    match /test/connection {
      allow read: if isSignedIn();
    }

    // 0. Global Safety Net (Bottom)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
