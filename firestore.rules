rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isSignedIn() && getUserData().role == 'teacher';
    }

    function isStudent() {
      return isSignedIn() && getUserData().role == 'student';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validations ---
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() > 0 
        && (data.role == 'teacher' || data.role == 'student')
        && data.createdAt == request.time;
    }

    // ... Higher level entities ...

    match /test/connection {
      allow read: if isSignedIn();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'role', 'classNumber', 'classId', 'classIds', 
            'subjectHandled', 'yearsOfTeaching', 'gender', 'bio', 'isOnline', 'lastActive', 'email'
          ]);
    }

    match /confessions/{confessionId} {
      allow read: if isSignedIn() && isValidId(confessionId);
      allow create: if isSignedIn() && isValidId(confessionId) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(confessionId) && (
        (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isAnonymous']))
        || (incoming().diff(existing()).affectedKeys().hasOnly(['likesCount']))
      );
      allow delete: if isSignedIn() && isValidId(confessionId) && (existing().authorId == request.auth.uid || isTeacher());
    }

    match /posts/{postId} {
      allow read: if isSignedIn() && isValidId(postId);
      allow create: if isSignedIn() && isValidId(postId) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(postId) && (
        (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'mediaUrl', 'mediaType', 'fileName', 'fileSize', 'youtubeId']))
        || (incoming().diff(existing()).affectedKeys().hasOnly(['likes']))
      );
      allow delete: if isSignedIn() && isValidId(postId) && (existing().authorId == request.auth.uid || isTeacher());
    }

    match /post_likes/{likeId} {
      allow read: if isSignedIn() && isValidId(likeId);
      allow create, delete: if isSignedIn() && isValidId(likeId) && request.auth.uid == likeId.split('_')[1];
    }

    match /confession_likes/{likeId} {
      allow read: if isSignedIn() && isValidId(likeId);
      allow create, delete: if isSignedIn() && isValidId(likeId) && request.auth.uid == likeId.split('_')[1];
    }

    match /comments/{commentId} {
      allow read: if isSignedIn() && isValidId(commentId);
      allow create: if isSignedIn() && isValidId(commentId) && incoming().authorId == request.auth.uid;
      allow delete: if isSignedIn() && isValidId(commentId) && (existing().authorId == request.auth.uid || isTeacher());
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn() && isValidId(lessonId);
      allow create: if isTeacher() && isValidId(lessonId) && incoming().teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && isValidId(lessonId) && existing().teacherId == request.auth.uid;
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && isValidId(assignmentId);
      allow create: if isTeacher() && isValidId(assignmentId) && incoming().teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && isValidId(assignmentId) && existing().teacherId == request.auth.uid;
    }

    match /submissions/{submissionId} {
      allow get: if isSignedIn() && isValidId(submissionId) && (isOwner(existing().studentId) || isTeacher());
      allow list: if isSignedIn() && (isTeacher() || (isStudent() && resource.data.studentId == request.auth.uid));
      allow create: if isStudent() && isValidId(submissionId) && incoming().studentId == request.auth.uid;
      allow update: if isTeacher() && isValidId(submissionId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['grade', 'feedback', 'status']);
    }

    match /quizzes/{quizId} {
      allow read: if isSignedIn() && isValidId(quizId);
      allow create: if isTeacher() && isValidId(quizId) && incoming().teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && isValidId(quizId) && existing().teacherId == request.auth.uid;
    }

    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && isValidId(attemptId) && (isOwner(existing().studentId) || isTeacher());
      allow create: if isStudent() && isValidId(attemptId) && incoming().studentId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && isValidId(notificationId) && isOwner(resource.data.userId);
      allow create: if isSignedIn() && isValidId(notificationId);
      allow update: if isSignedIn() && isValidId(notificationId) && isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && isValidId(notificationId) && isOwner(existing().userId);
    }

    match /classes/{classId} {
      allow read: if isSignedIn() && isValidId(classId);
      allow create: if isTeacher() && isValidId(classId) && incoming().teacherId == request.auth.uid;
      allow update: if isValidId(classId) && (isTeacher() && existing().teacherId == request.auth.uid);
      allow delete: if isTeacher() && isValidId(classId) && existing().teacherId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if isSignedIn() && isValidId(messageId);
        allow create: if isSignedIn() && isValidId(messageId) && incoming().senderId == request.auth.uid;
        allow delete: if isSignedIn() && isValidId(messageId) && (existing().senderId == request.auth.uid || isTeacher());
        allow update: if isSignedIn() && isValidId(messageId) && incoming().diff(existing()).affectedKeys().hasOnly(['reactions']);
      }
    }

    match /chats/{chatId} {
      allow read: if isSignedIn() && isValidId(chatId) && chatId.contains(request.auth.uid);
      allow create: if isSignedIn() && isValidId(chatId) && chatId.contains(request.auth.uid);
      allow update: if isSignedIn() && isValidId(chatId) && chatId.contains(request.auth.uid) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['lastRead', 'lastMessageTime']);

      match /messages/{messageId} {
        allow read: if isSignedIn() && isValidId(messageId) && chatId.contains(request.auth.uid);
        allow create: if isSignedIn() && isValidId(messageId) && incoming().senderId == request.auth.uid;
        allow delete: if isSignedIn() && isValidId(messageId) && existing().senderId == request.auth.uid;
        allow update: if isSignedIn() && isValidId(messageId) && incoming().diff(existing()).affectedKeys().hasOnly(['reactions']);
      }

      match /typing/{userId} {
        allow read: if isSignedIn() && isValidId(userId) && chatId.contains(request.auth.uid);
        allow write: if isOwner(userId) && isValidId(userId) && chatId.contains(request.auth.uid);
      }
    }

    match /reminders/{reminderId} {
      allow read: if isSignedIn() && isValidId(reminderId);
      allow create: if isTeacher() && isValidId(reminderId) && incoming().teacherId == request.auth.uid;
      allow update, delete: if isTeacher() && isValidId(reminderId) && existing().teacherId == request.auth.uid;
    }

    match /friends/{friendshipId} {
      allow read: if isSignedIn() && isValidId(friendshipId) && (isOwner(resource.data.user1) || isOwner(resource.data.user2));
      allow create: if isSignedIn() && isValidId(friendshipId) && incoming().user1 == request.auth.uid;
      allow update: if isSignedIn() && isValidId(friendshipId) && (isOwner(existing().user1) || isOwner(existing().user2)) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isSignedIn() && isValidId(friendshipId) && (isOwner(existing().user1) || isOwner(existing().user2));
    }

    match /calendarEvents/{eventId} {
      allow read: if isSignedIn() && isValidId(eventId);
      allow write: if isTeacher() && isValidId(eventId);
    }
    
    match /messages/{messageId} {
      allow read: if isSignedIn() && isValidId(messageId);
      allow create: if isSignedIn() && isValidId(messageId) && incoming().senderId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(messageId) && incoming().diff(existing()).affectedKeys().hasOnly(['readBy', 'reactions']);
    }
  }
}
